# === Supabase (obrigatório para todos) ===
SUPABASE_URL=seu_supabase_url
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# === Hablla ===
HABLLA_TOKEN=seu_token_ou_deixe_vazio_para_login
HABLLA_EMAIL=seu_email_hablla
HABLLA_PASSWORD=sua_senha_hablla
HABLLA_WORKSPACE_ID=id_do_workspace
HABLLA_BOARD_ID=id_do_board
HABLLA_CARDS_DAYS=7
HABLLA_CARDS_MAX_PAGES=500

# === Zoho ===
ZOHO_CLIENT_ID=seu_client_id
ZOHO_APP_NAME=nome_do_app
ZOHO_CLIENT_SECRET=seu_client_secret
ZOHO_REFRESH_TOKEN=seu_refresh_token
ZOHO_ACCOUNT_OWNER=seu_account_owner

# Zoho Service Order
ZOHO_SERVICE_ORDER_REPORT_NAME=nome_do_reporte

# === Omie ===
OMIE_APP_KEY=sua_app_key
OMIE_APP_SECRET=seu_app_secret
OMIE_ACCOUNT_NAME=nome_da_empresa_omie
OMIE_VENDAS_DAYS=30
OMIE_SERVICOS_DAYS=30
OMIE_FINANCAS_DAYS=30

# Opcional: use quando precisar consolidar mais de um aplicativo/loja Omie.
OMIE_CREDENTIALS={"Sede":{"appKey":"sua_app_key","appSecret":"seu_app_secret"}}

OMIE_APP_KEY_1=sua_app_key_loja_1
OMIE_APP_SECRET_1=seu_app_secret_loja_1
OMIE_ACCOUNT_NAME_1=nome_da_empresa_omie_1

OMIE_APP_KEY_2=sua_app_key_loja_2
OMIE_APP_SECRET_2=seu_app_secret_loja_2
OMIE_ACCOUNT_NAME_2=nome_da_empresa_omie_2

# === Google Sheets ===
GOOGLE_TOKEN=token_temporario_opcional
GOOGLE_CLIENT_EMAIL=email_da_service_account
GOOGLE_PRIVATE_KEY=chave_privada_da_service_account
